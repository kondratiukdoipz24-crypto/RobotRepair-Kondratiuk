    <ui:Instance template="NPCDialogue" name="NPCDialogue" style="position: absolute; top: 70%; right: 10%; bottom: 0%; left: 10%; font-size: 30px; -unity-font-definition: resource(&quot;FlatSkin/Font/Roboto-MediumItalic&quot;);"/>
