        <ui:VisualElement name="CharacterPortrait" style="flex-grow: 0; -unity-background-scale-mode: scale-to-fit; position: absolute; left: -85px; top: 5px; right: 0; bottom: 5px; background-image: url(&quot;project://database/Assets/_2DAdventureGame/Art/Ruby/UI/CharacterPortrait.png?fileID=2800000&amp;guid=374193bc7008fa34ab9b2bbca376937b&amp;type=3#CharacterPortrait&quot;); background-size: 20% 78%; opacity: 1;"/>
